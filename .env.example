# EmailJS configuration for the contact form.
# Get these from https://dashboard.emailjs.com/ (Service, Template, Account -> API Keys).
# Copy this file to ".env" for local builds. Never commit the real ".env".
#
# For the GitHub Actions deployment, add the same names as repository secrets:
# Settings -> Secrets and variables -> Actions -> New repository secret.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Supabase configuration (Stage 7A Foundation).
# Get these from your Supabase project: Project Settings -> API.
# - VITE_SUPABASE_URL: the project URL, e.g. https://xxxx.supabase.co
# - VITE_SUPABASE_ANON_KEY: the publishable anon/public key.
#
# SECURITY: Only the anon key may be used in the frontend. NEVER use the
# service_role key here or anywhere in the client. It must stay server-side.
#
# For the GitHub Actions deployment, add the same names as repository secrets:
# Settings -> Secrets and variables -> Actions -> New repository secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=