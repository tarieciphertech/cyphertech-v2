# EmailJS configuration for the contact form.
# Get these from https://dashboard.emailjs.com/ (Service, Template, Account -> API Keys).
# Copy this file to ".env" for local builds. Never commit the real ".env".
#
# For the GitHub Actions deployment, add the same names as repository secrets:
# Settings -> Secrets and variables -> Actions -> New repository secret.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
